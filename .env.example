# ==============================================================================
# The Lenny Growth Assistant — Environment Configuration
# ==============================================================================

# Application Environment (development, production, test)
ENVIRONMENT=development
LOG_LEVEL=INFO
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Database Persistence (PostgreSQL with pgvector)
# For local Docker Compose: postgresql+asyncpg://postgres:postgres@postgres:5432/lenny_assistant
# For local host development: postgresql+asyncpg://postgres:postgres@localhost:5432/lenny_assistant
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lenny_assistant
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/lenny_assistant

# LLM Provider Configuration: 'mock' (offline demo), 'ollama' (local GPU/CPU), or 'cloud' (OpenAI/Anthropic)
LLM_PROVIDER=mock

# Local Ollama Settings (used when LLM_PROVIDER=ollama)
# In Docker on Windows/Mac, use: http://host.docker.internal:11434
# On local host, use: http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=60.0

# Cloud Provider Settings (used when LLM_PROVIDER=cloud)
# Provider options: 'anthropic' or 'openai'
CLOUD_PROVIDER=anthropic
CLOUD_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
CLOUD_TIMEOUT_SECONDS=45.0

# Embedding Provider Configuration: 'local' or 'openai'
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Grounding & Retrieval Guardrails
# Normalized hybrid threshold (0.0 to 1.0) combining dense semantic cosine similarity & lexical match
GROUNDING_SIMILARITY_THRESHOLD=0.30
MAX_RETRIEVAL_CHUNKS=6

# Artifact Security Policy
ALLOW_ARTIFACT_SCRIPTS=true
SANITIZE_ARTIFACT_HTML=true

